{
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "SKILL.md"
    },
    "api/view-archboard-dig.ts": {
      "includeFiles": "{data/*.sqlite,dist/index.html}"
    },
    "api/projects.ts": {
      "includeFiles": "data/*.sqlite"
    },
    "api/profile.ts": {
      "includeFiles": "data/*.sqlite"
    },
    "api/project-share.ts": {
      "includeFiles": "data/*.sqlite"
    }
  },
  "rewrites": [
    {
      "source": "/view-archboard-dig",
      "destination": "/api/view-archboard-dig"
    },
    {
      "source": "/view-archboard-dig/",
      "destination": "/api/view-archboard-dig"
    },
    {
      "source": "/api/projects",
      "destination": "/api/projects"
    },
    {
      "source": "/api/project-share",
      "destination": "/api/project-share"
    },
    {
      "source": "/([a-f0-9]{32})/live/img/(svg|png)/(.+)\\.(svg|png)",
      "destination": "/api/project-share?profileHash=$1&format=$2&filename=$3.$4"
    },
    {
      "source": "/([a-f0-9]{32})/profile",
      "destination": "/api/profile?profileHash=$1"
    },
    {
      "source": "/([a-f0-9]{32})/projects/(.+)",
      "destination": "/index.html"
    },
    {
      "source": "/([a-f0-9]{32})/profile/",
      "destination": "/api/profile?profileHash=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
